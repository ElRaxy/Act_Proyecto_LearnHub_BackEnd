<%- include('partials/header') %>
<div class="bg"></div>

<div class="wrap fadeUp">
  <h1>Registro de usuario</h1>

  <form action="/register" method="POST" class="user-form">
    <label>
      DNI
      <input type="text" name="dni" required minlength="9" maxlength="9" />
    </label>

    <label>
      Nombre
      <input type="text" name="firstName" required />
    </label>

    <label>
      Apellidos
      <input type="text" name="lastName" required />
    </label>

    <label>
      Email
      <input type="email" name="email" required />
    </label>

    <label>
      Teléfono
      <input type="text" name="phone" required />
    </label>

    <label>
      Fecha de nacimiento
      <input type="date" name="birthDate" required />
    </label>

    <label>
      Perfil
      <select name="profile">
        <option value="ALUMNO" selected>Alumno</option>
        <option value="PROFESOR">Profesor</option>
        <option value="ADMINISTRADOR">Administrador</option>
      </select>
    </label>

    <label>
      Contraseña
      <input type="password" name="password" required />
    </label>

    <div class="actions">
      <button type="submit" class="btn btn-add">Crear usuario</button>

      <a href="/users" class="btn btn-back"> Volver </a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
