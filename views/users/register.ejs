<%- include('../partials/header') %>

    <div class="wrap">
        <h1>Registro de Usuario</h1>

        <div class="form-card">
            <form action="/users/rss/register" method="POST">
                <div class="form-group">
                    <label for="firstName">Nombre</label>
                    <input type="text" name="firstName" id="firstName"
                        class="<%= locals.errors?.firstName ? 'input-error' : '' %>"
                        value="<%= locals.formData?.firstName || '' %>" required />
                    <% if (locals.errors?.firstName) { %>
                        <span class="error-message">
                            <%= locals.errors.firstName %>
                        </span>
                        <% } %>
                </div>

                <div class="form-group">
                    <label for="lastName">Apellido</label>
                    <input type="text" name="lastName" id="lastName"
                        class="<%= locals.errors?.lastName ? 'input-error' : '' %>"
                        value="<%= locals.formData?.lastName || '' %>" required />
                    <% if (locals.errors?.lastName) { %>
                        <span class="error-message">
                            <%= locals.errors.lastName %>
                        </span>
                        <% } %>
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" name="email" id="email" class="<%= locals.errors?.email ? 'input-error' : '' %>"
                        value="<%= locals.formData?.email || '' %>" required />
                    <% if (locals.errors?.email) { %>
                        <span class="error-message">
                            <%= locals.errors.email %>
                        </span>
                        <% } %>
                </div>

                <div class="form-group">
                    <label for="dni">DNI</label>
                    <input type="text" name="dni" id="dni" class="<%= locals.errors?.dni ? 'input-error' : '' %>"
                        value="<%= locals.formData?.dni || '' %>" required minlength="9" maxlength="9" />
                    <% if (locals.errors?.dni) { %>
                        <span class="error-message">
                            <%= locals.errors.dni %>
                        </span>
                        <% } %>
                </div>

                <div class="form-group">
                    <label for="phone">Teléfono</label>
                    <input type="text" name="phone" id="phone" class="<%= locals.errors?.phone ? 'input-error' : '' %>"
                        value="<%= locals.formData?.phone || '' %>" required />
                    <% if (locals.errors?.phone) { %>
                        <span class="error-message">
                            <%= locals.errors.phone %>
                        </span>
                        <% } %>
                </div>

                <div class="form-group">
                    <label for="birthDate">Fecha de Nacimiento</label>
                    <input type="date" name="birthDate" id="birthDate"
                        class="<%= locals.errors?.birthDate ? 'input-error' : '' %>"
                        value="<%= locals.formData?.birthDate || '' %>" required />
                    <% if (locals.errors?.birthDate) { %>
                        <span class="error-message">
                            <%= locals.errors.birthDate %>
                        </span>
                        <% } %>
                </div>

                <div class="form-group">
                    <label for="profile">Perfil</label>
                    <select name="profile" id="profile" class="<%= locals.errors?.profile ? 'input-error' : '' %>"
                        required>
                        <option value="ALUMNO" <%=locals.formData?.profile==='ALUMNO' ? 'selected' : '' %>
                            >Alumno</option>
                        <option value="PROFESOR" <%=locals.formData?.profile==='PROFESOR' ? 'selected' : '' %>
                            >Profesor</option>
                        <option value="ADMINISTRADOR" <%=locals.formData?.profile==='ADMINISTRADOR' ? 'selected' : '' %>
                            >Administrador</option>
                    </select>
                    <% if (locals.errors?.profile) { %>
                        <span class="error-message">
                            <%= locals.errors.profile %>
                        </span>
                        <% } %>
                </div>

                <div class="form-group">
                    <label for="password">Contraseña</label>
                    <div class="password-wrapper">
                        <input type="password" name="password" id="password"
                            class="<%= locals.errors?.password ? 'input-error' : '' %>" required />
                        <i class="fa-solid fa-eye toggle-password" id="togglePassword"></i>
                    </div>
                    <small id="passwordHelp"
                        style="color: #bcd5ff; font-size: 0.8rem; margin-top: 0.3rem; display: block;">
                        Mínimo 6 caracteres.
                    </small>
                    <% if (locals.errors?.password) { %>
                        <span class="error-message">
                            <%= locals.errors.password %>
                        </span>
                        <% } %>
                </div>

                <button type="submit" class="btn btn-add" style="width: 100%; margin-top: 1rem;">
                    <i class="fa-solid fa-user-plus"></i> Registrarse
                </button>
            </form>

            <div class="form-footer">
                <p>¿Ya tienes cuenta?</p>
                <a href="/users/rss/login" class="btn btn-secondary">
                    <i class="fa-solid fa-right-to-bracket"></i> Inicia sesión
                </a>
            </div>
        </div>
    </div>

    <script>
        const togglePassword = document.querySelector('#togglePassword');
        const password = document.querySelector('#password');

        togglePassword.addEventListener('click', function (e) {
            const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
            password.setAttribute('type', type);
            this.classList.toggle('fa-eye-slash');
        });

        // Simple client-side validation feedback
        password.addEventListener('input', function () {
            const help = document.getElementById('passwordHelp');
            if (this.value.length < 6) {
                help.style.color = '#ffb6b6';
                help.textContent = 'Faltan ' + (6 - this.value.length) + ' caracteres.';
            } else {
                help.style.color = '#a8c9ff';
                help.textContent = 'Contraseña válida.';
            }
        });
    </script>

    <%- include('../partials/footer') %>
