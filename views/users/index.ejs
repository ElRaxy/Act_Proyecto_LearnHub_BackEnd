<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles.css" />
    <title><%= tituloEJS %></title>
  </head>
  <body>
    <div class="bg"></div>
    <header><%- include('../partials/header') %></header>

    <div class="wrap fadeUp" style="--d: 0.2s">
      <!-- ALERTA FLOTANTE -->
      <div id="alert" class="custom-alert" style="display: none"></div>

      <!-- BOTÓN CREAR NUEVO -->
      <div class="actions">
        <a href="<%= baseUrlUsers %>/new" class="btn btn-add"
          >Crear Nuevo Usuario</a
        >
      </div>

      <!-- TABLA DE USUARIOS -->
      <div class="table-container">
        <table class="courses-table">
          <thead>
            <tr>
              <th>DNI</th>
              <th>Nombre</th>
              <th>Apellido</th>
              <th>Email</th>
              <th>Teléfono</th>
              <th>Perfil</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
            <tr>
              <td><%= user.dni %></td>
              <td><%= user.firstName %></td>
              <td><%= user.lastName %></td>
              <td><%= user.email %></td>
              <td><%= user.phone %></td>
              <td><%= user.profile %></td>
              <td>
                <a
                  href="<%= baseUrlUsers %>/show/<%= user._id %>"
                  class="btn btn-show"
                  >Ver</a
                >
                <a
                  href="<%= baseUrlUsers %>/edit/<%= user._id %>"
                  class="btn btn-edit"
                  >Editar</a
                >
                <form
                  action="<%= baseUrlUsers %>/<%= user._id %>?_method=DELETE"
                  method="POST"
                  style="display: inline"
                >
                  <input type="hidden" name="_method" value="DELETE" />
                  <button type="submit" class="btn btn-delete">Borrar</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <%- include('../partials/footer') %>

