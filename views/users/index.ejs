<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/styles.css">
  <title>Lista de Usuarios</title>
</head>

<body>
  <!-- Fondo animado -->
  <div class="bg"></div>

  <!-- Contenedor general -->
  <div class="wrap fadeUp" style="--d: .2s">
    <h1>Gestión de Usuarios</h1>

    <!-- Botón añadir usuario -->
    <div class="actions">
      <a href="/users/new" class="btn"><i class="fa-solid fa-plus"></i> Nuevo Usuario</a>
    </div>

    <% if (users.length === 0) { %>

      <p>No hay usuarios registrados.</p>

    <% } else { %>

      <div class="options">
        <% users.forEach(u => { %>

        <div class="item fadeUp" style="--d: .3s">
          <div class="iconFrame">
            <i class="fa-solid fa-user"></i>
          </div>

          <div>
            <p><strong>Nombre:</strong> <%= u.firstName %> <%= u.lastName %></p>
            <p><strong>Email:</strong> <%= u.email %></p>
            <p><strong>DNI:</strong> <%= u.dni %></p>
          </div>

          <div>
            <a href="/users/<%= u._id %>/edit" class="btn">Editar</a>

            <form action="/users/<%= u._id %>?_method=DELETE" method="POST" style="display:inline;">
              <button type="submit" class="btn">Eliminar</button>
            </form>
          </div>
        </div>

        <% }) %>
      </div>

    <% } %>

  </div>
</body>
</html>
