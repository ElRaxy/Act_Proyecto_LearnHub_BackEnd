<%- include('../partials/header') %>

<div class="wrap">
  <h1>Editar Usuario</h1>

  <form action="<%= baseUrlUsers %>/<%= user._id %>?_method=PUT" method="POST" class="form-card">
    <div class="form-group">
      <label for="firstName">Nombre</label>
      <input type="text" name="firstName" id="firstName" value="<%= user.firstName %>" required />
    </div>

    <div class="form-group">
      <label for="lastName">Apellido</label>
      <input type="text" name="lastName" id="lastName" value="<%= user.lastName %>" required />
    </div>

    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" name="email" id="email" value="<%= user.email %>" required />
    </div>

    <div class="form-group">
      <label for="dni">DNI</label>
      <input type="text" name="dni" id="dni" value="<%= user.dni %>" required />
    </div>

    <div class="form-group">
      <label for="phone">Teléfono</label>
      <input type="text" name="phone" id="phone" value="<%= user.phone %>" required />
    </div>

    <div class="form-group">
      <label for="birthDate">Fecha de Nacimiento</label>
      <input type="date" name="birthDate" id="birthDate" value="<%= user.birthDate.toISOString().split('T')[0] %>" required />
    </div>

    <div class="form-group">
      <label for="profile">Perfil</label>
      <select name="profile" id="profile" required>
        <option value="ADMINISTRADOR" <%= user.profile === 'ADMINISTRADOR' ? 'selected' : '' %>>Administrador</option>
        <option value="PROFESOR" <%= user.profile === 'PROFESOR' ? 'selected' : '' %>>Profesor</option>
        <option value="ALUMNO" <%= user.profile === 'ALUMNO' ? 'selected' : '' %>>Alumno</option>
      </select>
    </div>

    <div class="form-group">
      <label for="password">Contraseña (Dejar en blanco para no cambiar)</label>
      <div class="password-container">
        <input
          type="password"
          name="password"
          id="password"
          minlength="6"
          placeholder="Nueva contraseña (opcional)"
        />
        <button type="button" id="togglePassword" class="toggle-password-btn" title="Mostrar/Ocultar contraseña">
          <i class="fa-solid fa-eye" id="eyeIcon"></i>
        </button>
      </div>
      <small style="color: #bcd5ff; font-size: 0.8rem; margin-top: 5px; display: block;"> Mínimo 6 caracteres. </small>
    </div>

    <div class="actions">
      <button type="submit" class="btn btn-edit">
        <i class="fa-solid fa-save"></i> Guardar Cambios
      </button>
      <div class="secondary-action">
        <a href="<%= baseUrlUsers %>" class="btn-link">Volver al listado</a>
      </div>
    </div>
  </form>
</div>

<script>
  const passwordInput = document.getElementById("password");
  const togglePassword = document.getElementById("togglePassword");
  const eyeIcon = document.getElementById("eyeIcon");

  togglePassword.addEventListener("click", () => {
    const isPassword = passwordInput.getAttribute("type") === "password";
    passwordInput.setAttribute("type", isPassword ? "text" : "password");
    eyeIcon.classList.toggle("fa-eye");
    eyeIcon.classList.toggle("fa-eye-slash");
  });
</script>

<%- include('../partials/footer') %>
