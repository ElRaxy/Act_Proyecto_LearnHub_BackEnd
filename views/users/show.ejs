<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title>Detalle Usuario</title>
</head>
<body>
  <div class="bg"></div>
  <header><%- include('../partials/header') %></header>

  <div class="wrap fadeUp" style="--d: 0.2s">
    <h1>Detalle del Usuario</h1>

    <div class="table-container">
      <table class="courses-table">
        <tbody>
          <tr><th>DNI</th><td><%= user.dni %></td></tr>
          <tr><th>Nombre</th><td><%= user.firstName %></td></tr>
          <tr><th>Apellido</th><td><%= user.lastName %></td></tr>
          <tr><th>Email</th><td><%= user.email %></td></tr>
          <tr><th>Teléfono</th><td><%= user.phone %></td></tr>
          <tr><th>Fecha de Nacimiento</th><td><%= user.birthDate.toISOString().split('T')[0] %></td></tr>
          <tr><th>Perfil</th><td><%= user.profile %></td></tr>
        </tbody>
      </table>
    </div>

    <div class="actions">
      <a href="<%= baseUrlUsers %>" class="btn btn-add">Volver al listado</a>
      <a href="<%= baseUrlUsers %>/edit/<%= user._id %>" class="btn btn-edit">Editar Usuario</a>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
