<%- include('../partials/header') %>

<div class="wrap">
  <div class="detail-card">
    <h1>Detalle del Usuario</h1>

    <div class="table-container">
      <table class="courses-table">
        <tbody>
          <tr><th>DNI</th><td><%= user.dni %></td></tr>
          <tr><th>Nombre</th><td><%= user.firstName %></td></tr>
          <tr><th>Apellido</th><td><%= user.lastName %></td></tr>
          <tr><th>Email</th><td><%= user.email %></td></tr>
          <tr><th>Teléfono</th><td><%= user.phone %></td></tr>
          <tr><th>Fecha de Nacimiento</th><td><%= user.birthDate.toISOString().split('T')[0] %></td></tr>
          <tr><th>Perfil</th><td><%= user.profile %></td></tr>
        </tbody>
      </table>
    </div>

    <div class="actions">
      <a href="<%= baseUrlUsers %>" class="btn btn-back">⬅ Volver</a>
      
      <% if (locals.user && locals.user.profile === 'ADMINISTRADOR') { %>
        <a href="<%= baseUrlUsers %>/edit/<%= user._id %>" class="btn btn-edit">Editar</a>
        <form action="<%= baseUrlUsers %>/<%= user._id %>?_method=DELETE" method="POST" style="display: inline;">
          <button class="btn btn-delete">Eliminar</button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
