<%- include('../partials/header') %>

<div class="wrap">
  <h1>Editar Matrícula</h1>

  <form action="<%= baseApi %>/<%= enrollment._id %>?_method=PUT" method="POST" class="form-card">
    <div class="form-group">
      <label for="userId">Alumno</label>
      <select name="userId" id="userId" required>
        <% 
          const currentUserId = enrollment.userId ? (enrollment.userId._id ? enrollment.userId._id.toString() : enrollment.userId.toString()) : '';
        %>
        <% users.forEach(user => { %>
          <option value="<%= user._id %>" <%= currentUserId === user._id.toString() ? 'selected' : '' %>>
            <%= user.firstName %> <%= user.lastName %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="courseId">Curso</label>
      <select name="courseId" id="courseId" required>
        <% 
          const currentCourseId = enrollment.courseId ? (enrollment.courseId._id ? enrollment.courseId._id.toString() : enrollment.courseId.toString()) : '';
        %>
        <% courses.forEach(course => { %>
          <option value="<%= course._id %>" <%= currentCourseId === course._id.toString() ? 'selected' : '' %>>
            <%= course.title %> - <%= course.category %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="enrollmentsDate">Fecha de matrícula</label>
      <input type="date" name="enrollmentsDate" id="enrollmentsDate" value="<%= enrollment.enrollmentsDate ? enrollment.enrollmentsDate.toISOString().split('T')[0] : '' %>" required>
    </div>

    <div class="form-group">
      <label for="status">Estado</label>
      <select name="status" id="status" required>
        <option value="pendiente" <%= enrollment.status === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
        <option value="aprobado" <%= enrollment.status === 'aprobado' ? 'selected' : '' %>>Aprobado</option>
        <option value="rechazado" <%= enrollment.status === 'rechazado' ? 'selected' : '' %>>Rechazado</option>
      </select>
    </div>

    <div class="form-group">
      <label for="notes">Notas</label>
      <textarea name="notes" id="notes"><%= enrollment.notes ? enrollment.notes : '' %></textarea>
    </div>

    <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
      <button type="submit" class="btn btn-edit">
        <i class="fa-solid fa-save"></i> Guardar Cambios
      </button>
      <a href="<%= baseApi %>" class="btn btn-back">
        <i class="fa-solid fa-times"></i> Cancelar
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
