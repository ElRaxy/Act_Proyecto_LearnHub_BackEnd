<%- include('../partials/header', { title: "Editar Matrícula" }) %>

<div class="wrap fadeUp" style="--d:0.2s">
  <h1>Editar Matrícula</h1>

  <form action="<%= baseApi %>/<%= enrollment._id %>?_method=PATCH" method="POST">
    <div class="form-group">
      <label for="userId">Alumno:</label>
      <select name="userId" id="userId" required>
        <% users.forEach(user => { %>
          <option value="<%= user._id %>" <%= enrollment.userId && enrollment.userId._id.toString() === user._id.toString() ? 'selected' : '' %>>
            <%= user.firstName %> <%= user.lastName %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="courseId">Curso:</label>
      <select name="courseId" id="courseId" required>
        <% courses.forEach(course => { %>
          <option value="<%= course._id %>" <%= enrollment.courseId && enrollment.courseId._id.toString() === course._id.toString() ? 'selected' : '' %>>
            <%= course.title %> - <%= course.category %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="form-group">
      <label for="enrollmentsDate">Fecha de matrícula:</label>
      <input type="date" name="enrollmentsDate" id="enrollmentsDate" value="<%= enrollment.enrollmentsDate ? enrollment.enrollmentsDate.toISOString().split('T')[0] : '' %>" required>
    </div>

    <div class="form-group">
      <label for="status">Estado:</label>
      <select name="status" id="status" required>
        <option value="pendiente" <%= enrollment.status === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
        <option value="aprobado" <%= enrollment.status === 'aprobado' ? 'selected' : '' %>>Aprobado</option>
        <option value="rechazado" <%= enrollment.status === 'rechazado' ? 'selected' : '' %>>Rechazado</option>
      </select>
    </div>

    <div class="form-group">
      <label for="notes">Notas:</label>
      <input type="text" name="notes" id="notes" value="<%= enrollment.notes ? enrollment.notes : '' %>">
    </div>

    <div class="actions">
      <button type="submit" class="btn btn-edit">Actualizar Matrícula</button>
      <a href="<%= baseApi %>" class="btn btn-add">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
