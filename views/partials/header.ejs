<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= typeof title !== 'undefined' ? title : (typeof tituloEJS !== 'undefined' ? tituloEJS : 'LearnHub') %></title>

  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="icon" type="image/svg+xml" href="/image/favicon.svg" />
</head>
<body>
  <div class="bg"></div>

  <header>
    <h2><%= typeof title !== 'undefined' ? title : (typeof tituloEJS !== 'undefined' ? tituloEJS : 'LearnHub') %></h2>
    <nav>
      <a href="/">Inicio</a>
      <a href="/courses/rss">Cursos</a>
      <a href="/enrollments/rss">Matrículas</a>
      <a href="/users/rss">Usuarios</a>

      <% if (user) { %>
        <span class="user-greeting">Hola, <%= user.firstName %> <%= user.lastName %></span>
        <a href="/users/rss/logout" class="btn-logout">Cerrar sesión</a>
      <% } else { %>
        <a href="/users/rss/login">Login</a>
        <a href="/users/rss/register">Registro</a>
      <% } %>
    </nav>
  </header>
