<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
      <%= typeof title !== 'undefined' ? title : (typeof tituloEJS !==
      'undefined' ? tituloEJS : 'LearnHub') %>
    </title>

    <link rel="stylesheet" href="/styles.css" />
    <link rel="icon" type="image/svg+xml" href="/image/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
  </head>
  <body>
    <div class="bg"></div>

    <header>
      <h2>
        <%= typeof title !== 'undefined' ? title : (typeof tituloEJS !==
        'undefined' ? tituloEJS : 'LearnHub') %>
      </h2>
      <nav>
        <a href="/">Inicio</a>
        <a href="/courses/views">Cursos</a>
        <a href="/enrollments/views">Matrículas</a>
        <% if (locals.currentUser && locals.currentUser.profile === 'ADMINISTRADOR') { %>
        <a href="/users/views">Usuarios</a>
        <% } %>
      </nav>

      <div class="user-info">
        <% if (locals.currentUser) { %>
          <span class="user-greeting">Hola, <strong><%= locals.currentUser.firstName || 'Usuario' %></strong></span>
          <a href="/users/views/logout" class="btn btn-logout">Cerrar Sesión</a>
<% } else { %>
          <a href="/users/views/login" class="btn btn-login">Entrar</a>
          <a href="/users/views/register" class="btn btn-register">Registrarse</a>
        <% } %>
      </div>
    </header>
  </body>
</html>
