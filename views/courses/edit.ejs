<%- include('../partials/header', { title: "Editar Curso" }) %>

<div class="wrap">
  <h1>Editar Curso</h1>

  <form action="<%= baseApi %>/<%= course._id %>?_method=PATCH" method="POST" class="form-card">
    <div class="form-group">
      <label>Título</label>
      <input type="text" name="title" value="<%= course.title %>" required>
    </div>

    <div class="form-group">
      <label>Descripción</label>
      <textarea name="description" required><%= course.description %></textarea>
    </div>

    <div class="form-group">
      <label>Categoría</label>
      <input type="text" name="category" value="<%= course.category %>" required>
    </div>

    <div class="form-group">
      <label>Fecha de inicio</label>
      <input type="date" name="startDate" value="<%= course.startDate.toISOString().substring(0,10) %>" required>
    </div>

    <div class="form-group">
      <label>Fecha de fin</label>
      <input type="date" name="endDate" value="<%= course.endDate.toISOString().substring(0,10) %>" required>
    </div>

    <div class="form-group">
      <label>Ubicación</label>
      <input type="text" name="location" value="<%= course.location %>" required>
    </div>

    <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
      <button class="btn btn-edit" type="submit">
        <i class="fa-solid fa-save"></i> Guardar Cambios
      </button>
      <a href="<%= baseApi %>" class="btn btn-back">
        <i class="fa-solid fa-times"></i> Cancelar
      </a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
