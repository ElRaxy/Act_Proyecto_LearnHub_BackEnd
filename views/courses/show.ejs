<%- include('../partials/header') %>

<div class="wrap">
  <div class="detail-card">
    <h1><%= course.title %></h1>

    <p class="description"><%= course.description %></p>

    <div class="table-container">
      <table class="courses-table">
        <tbody>
          <tr>
            <th>Categoría</th>
            <td><%= course.category %></td>
          </tr>
          <tr>
            <th>ID</th>
            <td><%= course._id %></td>
          </tr>
          <tr>
            <th>Ubicación</th>
            <td><%= course.location %></td>
          </tr>
          <tr>
            <th>Fecha de inicio</th>
            <td><%= new Date(course.startDate).toLocaleDateString() %></td>
          </tr>
          <tr>
            <th>Fecha de fin</th>
            <td><%= new Date(course.endDate).toLocaleDateString() %></td>
          </tr>
          <tr>
            <th>Creado</th>
            <td><%= new Date(course.createdAt).toLocaleString() %></td>
          </tr>
          <tr>
            <th>Última actualización</th>
            <td><%= new Date(course.updatedAt).toLocaleString() %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="actions">
      <a href="<%= baseApi %>" class="btn btn-back">⬅ Volver</a>

      <% if (locals.currentUser && (locals.currentUser.profile === 'ADMINISTRADOR' || locals.currentUser.profile === 'PROFESOR')) { %>
      <a href="<%= baseApi %>/<%= course._id %>/edit" class="btn btn-edit">Editar</a>
      <% } %>

      <% if (locals.currentUser && locals.currentUser.profile === 'ADMINISTRADOR') { %>
      <form action="<%= baseApi %>/<%= course._id %>?_method=DELETE" method="POST" style="display: inline;">
        <button class="btn btn-delete">Eliminar</button>
      </form>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
