<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestión de Cursos</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" type="image/svg+xml" href="/image/favicon.svg">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="bg"></div>

  <div class="wrap">
    <h1>Gestión de Cursos</h1>

    <div class="actions">
      <a href="/api/v1/courses/new" class="btn btn-add"><i class="fa-solid fa-plus"></i> Añadir Curso</a>
    </div>

    <div class="table-container">
      <table class="courses-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Descripción</th>
            <th>Categoría</th>
            <th>Fechas</th>
            <th>Ubicación</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (courses && courses.length) { %>
            <% courses.forEach(course => { %>
              <tr>
                <td><%= course._id %></td>
                <td><%= course.title %></td>
                <td><%= course.description %></td>
                <td><%= course.category %></td>
                <td>
                  <%= new Date(course.startDate).toLocaleDateString() %> -
                  <%= new Date(course.endDate).toLocaleDateString() %>
                </td>
                <td><%= course.location %></td>
                <td>
                  <a href="/api/v1/courses/<%= course._id %>/edit" class="btn btn-edit"><i class="fa-solid fa-pen"></i></a>
                  <form action="/api/v1/courses/<%= course._id %>?_method=DELETE" method="POST" class="inline-form">
                    <button type="submit" class="btn btn-delete"><i class="fa-solid fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7">No hay cursos disponibles.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
