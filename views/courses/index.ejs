<%- include('../partials/header') %>

<div class="wrap">
  <h1>Cursos disponibles</h1>

  <div class="actions">
    <a href="<%= baseApi %>/new" class="btn btn-add">➕ Nuevo curso</a>
  </div>

  <div class="table-container">
    <table class="courses-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Categoría</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% courses.forEach(c => { %>
          <tr>
            <td data-label="ID"><%= c._id %></td>
            <td data-label="Nombre"><%= c.name %></td>
            <td data-label="Descripción"><%= c.description %></td>
            <td data-label="Categoría"><%= c.category %></td>

            <td data-label="Acciones">
              <a href="<%= baseApi %>/<%= c._id %>" class="btn btn-edit">Ver</a>
              <a href="<%= baseApi %>/<%= c._id %>/edit" class="btn btn-edit">Editar</a>

              <form action="<%= baseApi %>/<%= c._id %>?_method=DELETE" method="POST">
                <button class="btn btn-delete">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
