<%- include('../partials/header') %>

<div class="wrap">
  <h1>Cursos disponibles</h1>

  <% if (locals.currentUser && (locals.currentUser.profile === 'ADMINISTRADOR' || locals.currentUser.profile === 'PROFESOR')) { %>
  <div class="actions">
    <a href="<%= baseApi %>/new" class="btn btn-add">Crear nuevo curso</a>
  </div>
  <% } %>

  <div class="table-container">
    <table class="courses-table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Descripción</th>
          <th>Categoría</th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% courses.forEach(c => { %>
        <tr>
          <td data-label="Nombre"><%= c.title %></td>
          <td data-label="Descripción"><%= c.description %></td>
          <td data-label="Categoría"><%= c.category %></td>

          <td data-label="Acciones">
            <a href="<%= baseApi %>/<%= c._id %>" class="btn btn-edit">Ver</a>

            <% if (locals.currentUser && (locals.currentUser.profile === 'ADMINISTRADOR' || locals.currentUser.profile === 'PROFESOR')) { %>
            <a href="<%= baseApi %>/<%= c._id %>/edit" class="btn btn-edit">Editar</a>
            <% } %>

            <% if (locals.currentUser && locals.currentUser.profile === 'ADMINISTRADOR') { %>
            <form
              action="<%= baseApi %>/<%= c._id %>?_method=DELETE"
              method="POST"
              class="delete-form"
            >
              <button class="btn btn-delete">Eliminar</button>
            </form>
            <% } %>

          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
