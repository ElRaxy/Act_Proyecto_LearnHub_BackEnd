<%- include('../partials/header') %>

<div class="wrap">
  <h1>Editar Curso</h1>

  <form
    action="<%= baseApi %>/<%= course._id %>?_method=PATCH"
    method="POST"
    class="form-card"
  >
    <div class="form-group">
      <label>Título</label>
      <input type="text" name="title" value="<%= course.title %>" required />
    </div>

    <div class="form-group">
      <label>Descripción</label>
      <textarea name="description" required><%= course.description %></textarea>
    </div>

    <div class="form-group">
      <label>Categoría</label>
      <input
        type="text"
        name="category"
        value="<%= course.category %>"
        required
      />
    </div>

    <div class="form-group">
      <label>Fecha de inicio</label>
      <input
        type="date"
        name="startDate"
        value="<%= course.startDate.toISOString().substring(0,10) %>"
        required
      />
    </div>

    <div class="form-group">
      <label>Fecha de fin</label>
      <input
        type="date"
        name="endDate"
        value="<%= course.endDate.toISOString().substring(0,10) %>"
        required
      />
    </div>

    <div class="form-group">
      <label>Ubicación</label>
      <input
        type="text"
        name="location"
        value="<%= course.location %>"
        required
      />
    </div>

    <a href="<%= baseApi %>" class="btn btn-back" style="margin-top: 1.5rem"
      ><i class="fa-solid fa-arrow-left"></i> Volver</a
    >

    <button class="btn btn-edit" style="margin-top: 1.5rem">
      <i class="fa-solid fa-save"></i> Guardar Cambios
    </button>
  </form>
</div>

<%- include('../partials/footer') %>
