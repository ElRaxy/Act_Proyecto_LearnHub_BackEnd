<%- include('../partials/header') %>

  <div class="wrap">
    <h1>Iniciar Sesión</h1>

    <div class="form-card">
      <% if (locals.errors?.general) { %>
        <div class="alert-inline">
          <i class="fa-solid fa-circle-exclamation"></i>
          <%= errors.general %>
        </div>
        <% } %>

          <form action="/users/views/login" method="POST">
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" name="email" id="email" class="<%= locals.errors?.email ? 'input-error' : '' %>"
                value="<%= locals.formData?.email || '' %>" required />
              <% if (locals.errors?.email) { %>
                <span class="error-message">
                  <%= errors.email %>
                </span>
                <% } %>
            </div>

            <div class="form-group">
              <label for="password">Contraseña</label>
              <div class="password-wrapper">
                <input type="password" name="password" id="password"
                  class="<%= locals.errors?.password ? 'input-error' : '' %>" required />
                <i class="fa-solid fa-eye toggle-password" id="togglePassword"></i>
              </div>
              <% if (locals.errors?.password) { %>
                <span class="error-message">
                  <%= errors.password %>
                </span>
                <% } %>
            </div>

            <button type="submit" class="btn btn-add" style="width: 100%; margin-top: 1rem;">
              <i class="fa-solid fa-right-to-bracket"></i> Entrar
            </button>
          </form>

          <div class="form-footer">
            <p>¿No tienes cuenta?</p>
            <a href="/users/views/register" class="btn btn-secondary">
              <i class="fa-solid fa-user-plus"></i> Regístrate aquí
            </a>
          </div>
    </div>
  </div>

  <script>
    const togglePassword = document.querySelector('#togglePassword');
    const password = document.querySelector('#password');

    togglePassword.addEventListener('click', function (e) {
      const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
      password.setAttribute('type', type);
      this.classList.toggle('fa-eye-slash');
    });
  </script>

  <%- include('../partials/footer') %>
